{
  "name": "x402-launchpad",
  "version": "1.0.0",
  "description": "x402 Launchpad for Robinhood Chain",
  "main": "server.js",
  "bin": {
    "olanas-payments-mcp": "payments-mcp/cli.js"
  },
  "scripts": {
    "payments:setup": "node payments-mcp/setup.js",
    "payments:mcp": "node payments-mcp/server.js",
    "payments:wallet": "node payments-mcp/server.js --wallet-only",
    "test:payments": "npm run payments:bundle && node --test tests/payments-mcp.test.js tests/payments-autonomous.test.js tests/payments-setup.test.js tests/payments-installer.test.js",
    "start": "node server.js",
    "start:testnet": "npm run build && node scripts/start-network.js testnet",
    "start:networks": "npm run build && node scripts/start-networks.js",
    "dev": "node server.js",
    "dev:testnet": "node scripts/start-network.js testnet",
    "dev:networks": "node scripts/start-networks.js --dev",
    "test": "node --test tests/regression.test.js",
    "test:production": "node --test --test-name-pattern=production: tests/regression.test.js",
    "test:handshake": "node --test --test-name-pattern=handshake: tests/regression.test.js",
    "test:paywall": "node --test --test-name-pattern=paywall: tests/regression.test.js",
    "test:browser": "node --test --test-name-pattern=browser: tests/regression.test.js",
    "test:smoke": "node tests/smoke/verify-link.js",
    "test:deployment": "node tests/smoke/verify-deployment.js",
    "build:assets": "node scripts/build-privy.js",
    "build": "npm run build:assets && next build --webpack",
    "prestart": "npm run build",
    "prepare": "npm run payments:bundle",
    "payments:olanas": "node --env-file=.local/payments.env payments-mcp/server.js --wallet-only",
    "payments:bundle": "node payments-mcp/build-package.js",
    "payments:install": "npm run payments:bundle && node payments-mcp/cli.js install",
    "payments:status": "node payments-mcp/cli.js status",
    "payments:uninstall": "node payments-mcp/cli.js uninstall"
  },
  "keywords": [
    "x402",
    "http-402",
    "robinhood-chain",
    "orbit-l2",
    "ai-agents",
    "micropayments",
    "payai",
    "pons"
  ],
  "author": "x402 Team",
  "license": "MIT",
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@privy-io/js-sdk-core": "^0.76.0",
    "@privy-io/node": "^0.34.0",
    "@privy-io/react-auth": "^3.43.0",
    "cors": "^2.8.5",
    "ethers": "^6.13.2",
    "express": "^5.0.1",
    "marked": "^16.4.2",
    "multer": "^2.4.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "esbuild-wasm": "0.28.2"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "viem": {
      "ws": "8.21.3"
    }
  }
}
