PORT=4020
PUBLIC_BASE_URL=http://localhost:4020
# Select mainnet or testnet. Testnet uses a separate ./uploads-testnet directory by default.
ROBINHOOD_NETWORK=mainnet
ROBINHOOD_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
# URLs used by the in-app network selector in deployed environments.
# Local development defaults to mainnet on :4020 and testnet on :4021.
ROBINHOOD_MAINNET_APP_URL=
ROBINHOOD_TESTNET_APP_URL=
ROBINHOOD_MAINNET_PORT=4020
ROBINHOOD_TESTNET_PORT=4021
# Set a cryptographically random secret of at least 32 characters.
# Keep the existing secret when opening existing encrypted files.
VAULT_MASTER_SECRET=
# False is the default. Never enable demos against a vault containing paid content.
X402_DEMO_MODE=false
# Optional dedicated persistent data directory (default: ./uploads)
X402_DATA_DIR=
# Testnet always uses this separate directory (default: ./uploads-testnet).
ROBINHOOD_TESTNET_DATA_DIR=
# Legacy mainnet token variables. ETH is always available.
USDC_CONTRACT_ADDRESS=
WETH_CONTRACT_ADDRESS=
X402PAY_CONTRACT_ADDRESS=
# Preferred network-scoped token variables. Never reuse mainnet addresses on testnet.
ROBINHOOD_MAINNET_USDC_CONTRACT_ADDRESS=
ROBINHOOD_MAINNET_WETH_CONTRACT_ADDRESS=
ROBINHOOD_MAINNET_X402PAY_CONTRACT_ADDRESS=
ROBINHOOD_TESTNET_USDC_CONTRACT_ADDRESS=
ROBINHOOD_TESTNET_WETH_CONTRACT_ADDRESS=
ROBINHOOD_TESTNET_X402PAY_CONTRACT_ADDRESS=
# Optional authenticated browser wallet login
PRIVY_APP_ID=
# Optional encrypted IPFS pinning
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/
PINATA_GATEWAY_TOKEN=
# Hosted API gateway limits.
X402_PROXY_TIMEOUT_MS=15000
X402_PROXY_MAX_RESPONSE_BYTES=10485760

