# ==============================================================================
# x402 Robinhood Paywall — Production Environment Configuration
# Network: Robinhood Chain (Arbitrum Orbit L2, Chain ID: 4663)
# ==============================================================================

# Server Port
PORT=4020

# Mainnet only. Other ROBINHOOD_NETWORK values are rejected.
ROBINHOOD_NETWORK=mainnet

# Robinhood Chain Official RPC URL (Orbit L2)
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_CHAIN_ID=4663
ROBINHOOD_EXPLORER_URL=https://robinhoodchain.blockscout.com

# Vault AES-256-GCM Master Secret Key (For encrypted storage at rest)
VAULT_MASTER_SECRET=

# Facilitator Treasury Wallet (Settlement recipient & relayer)
FACILITATOR_WALLET=

# Supported Stablecoins on Robinhood Chain
USDC_CONTRACT_ADDRESS=

# Official Privy App Credentials (Configured from console.privy.io)
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Real Decentralized IPFS Storage (Powered by Pinata)
PINATA_API_KEY=
PINATA_API_SECRET=
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Optional metered Orbio inference gateway. Keep the key server-side.
ORBIO_API_KEY=
OLANAS_INFERENCE_PAYOUT_ADDRESS=

# x402 escrow inference. Dedicated Robinhood Chain wallet pays facilitator gas
# and receives claimed USDG. Never use an agent/user wallet private key here.
OLANAS_ESCROW_PRIVATE_KEY=
# Vercel cron supplies Authorization: Bearer CRON_SECRET to the hourly claim job.
CRON_SECRET=
